{
  "name": "shadpanel",
  "version": "1.6.0",
  "description": "ShadPanel CLI - Build admin panels with Next.js and shadcn/ui",
  "main": "index.cjs",
  "type": "module",
  "bin": {
    "shadpanel": "./dist/cli.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build:cli": "tsup",
    "dev:cli": "tsx cli/index.ts",
    "prepublishOnly": "npm run build:cli"
  },
  "files": [
    "dist",
    "templates",
    "components",
    "lib",
    "hooks",
    "contexts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "keywords": [
    "panel",
    "ui",
    "component",
    "shadcn",
    "react",
    "nextjs",
    "cli",
    "scaffold"
  ],
  "author": "kristiansnts <epafroditus.kristian@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kristiansnts/shadpanel.git"
  },
  "bugs": {
    "url": "https://github.com/kristiansnts/shadpanel/issues"
  },
  "homepage": "https://shadpanel-docs.vercel.app",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "fs-extra": "^11.3.2",
    "ora": "^9.0.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
